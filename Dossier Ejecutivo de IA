                                        <th class="px-6 py-4">Esfuerzo</th>
                                        <th class="px-6 py-4">Velocidad de Valor</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    ${tableRows}
                                </tbody>
                            </table>
                        </div>
                        <div class="p-4 bg-blue-50 border-t border-blue-100 text-sm text-blue-800 flex items-start">
