                                        <p class="font-bold">Esquema Human-in-the-Loop</p>
                                        <p class="text-xs text-blue-200">El Director Técnico permanece como validador final de toda certificación.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div>
                        <h3 class="text-xl font-bold text-slate-800 mb-4">Barreras y Estrategias de Mitigación</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="bg-white p-4 rounded-xl border border-slate-200 flex space-x-4">
                                <div class="text-slate-400"><i data-lucide="users" class="w-6 h-6"></i></div>
                                <div>
                                    <h4 class="font-bold text-slate-900 text-sm">Cultura: Miedo al reemplazo</h4>
                                    <p class="text-xs text-slate-600 mt-1"><strong>Mitigación:</strong> Formación práctica. Comunicar que el humano es el "Director/Validador".</p>
                                </div>
                            </div>
                            <div class="bg-white p-4 rounded-xl border border-slate-200 flex space-x-4">
                                <div class="text-slate-400"><i data-lucide="brain-circuit" class="w-6 h-6"></i></div>
                                <div>
                                    <h4 class="font-bold text-slate-900 text-sm">Talento: Brecha Técnica</h4>
                                    <p class="text-xs text-slate-600 mt-1"><strong>Mitigación:</strong> Identificación de Champions en cada base operativa.</p>
                                </div>
                            </div>
                            <div class="bg-white p-4 rounded-xl border border-slate-200 flex space-x-4">
                                <div class="text-slate-400"><i data-lucide="database" class="w-6 h-6"></i></div>
                                <div>
                                    <h4 class="font-bold text-slate-900 text-sm">Datos: PDFs Desestructurados</h4>
                                    <p class="text-xs text-slate-600 mt-1"><strong>Mitigación:</strong> Modelos de IA para limpiar y categorizar datos antes de RAG.</p>
                                </div>
                            </div>
                            <div class="bg-white p-4 rounded-xl border border-slate-200 flex space-x-4">
                                <div class="text-slate-400"><i data-lucide="cpu" class="w-6 h-6"></i></div>
                                <div>
                                    <h4 class="font-bold text-slate-900 text-sm">Tecnología: Legacy sin APIs</h4>
                                    <p class="text-xs text-slate-600 mt-1"><strong>Mitigación:</strong> Arquitectura Cloud Agnóstica con capas intermedias.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }

        // --- Core Logic ---

        function renderSidebar() {
            const navContainer = document.getElementById('sidebar-nav');
            navContainer.innerHTML = sections.map(section => `
                <button 
                    onclick="changeSection('${section.id}')"
                    class="sidebar-item w-full flex items-center space-x-3 px-4 py-3 rounded-lg text-left ${activeSectionId === section.id ? 'active' : 'text-slate-400'}"
                >
                    <i data-lucide="${section.icon}" class="w-5 h-5 ${activeSectionId === section.id ? 'text-blue-200' : 'text-slate-500'}"></i>
                    <span class="font-medium">${section.label}</span>
                </button>
            `).join('');
            
            // Re-initialize icons for newly added HTML
            lucide.createIcons();
        }

        function renderContent() {
            const mainContainer = document.getElementById('main-content');
            let contentHTML = '';

            switch (activeSectionId) {
                case 'context': contentHTML = generateContextHTML(); break;
                case 'ecosystem': contentHTML = generateEcosystemHTML(); break;
                case 'opportunities': contentHTML = generateOpportunitiesHTML(); break;
                case 'roadmap': contentHTML = generateRoadmapHTML(); break;
                case 'recommendation': contentHTML = generateRecommendationHTML(); break;
                default: contentHTML = generateContextHTML();
            }

            mainContainer.innerHTML = contentHTML;
            // Re-initialize icons for the main content area
            lucide.createIcons();
        }

        // Global function called by buttons
        window.changeSection = function(sectionId) {
            if (activeSectionId !== sectionId) {
                activeSectionId = sectionId;
                renderSidebar();
                renderContent();
            }
        };

        // Initialize application
        document.addEventListener('DOMContentLoaded', () => {
            renderSidebar();
            renderContent();
        });
    </script>
</body>
</html>
