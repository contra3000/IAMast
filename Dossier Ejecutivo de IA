        function generateOpportunitiesHTML() {
            const cases = [
                { name: 'Gestión Adiestramientos', impact: 'Muy Alto', viability: 'Alta', data: 'Estructurados', effort: 'Bajo', speed: 'Muy Rápida', rec: true },
                { name: 'Asistente Mantenimiento', impact: 'Alto', viability: 'Media', data: 'Desestructurados', effort: 'Medio', speed: 'Media' },
                { name: 'Automatización Partes', impact: 'Medio', viability: 'Alta', data: 'Mixtos', effort: 'Bajo', speed: 'Rápida' },
                { name: 'Predicción Disponibilidad', impact: 'Muy Alto', viability: 'Baja', data: 'Históricos', effort: 'Alto', speed: 'Lenta' },
                { name: 'Logística Repuestos', impact: 'Medio', viability: 'Media', data: 'Estructurados', effort: 'Medio', speed: 'Media' },
                { name: 'Copiloto Operaciones', impact: 'Medio', viability: 'Alta', data: 'Externos', effort: 'Bajo', speed: 'Rápida' },
            ];

            const getStyleClass = (val) => {
                if (['Muy Alto', 'Alta', 'Muy Rápida', 'Bajo'].includes(val)) return 'badge-success';
                if (['Alto', 'Rápida'].includes(val)) return 'badge-info';
                if (['Medio', 'Media', 'Mixtos'].includes(val)) return 'badge-warning';
                if (['Baja', 'Lenta', 'Alto', 'Desestructurados'].includes(val)) return 'badge-danger';
                return 'badge-neutral';
            };

            const tableRows = cases.map(c => `
                <tr class="table-row-hover ${c.rec ? 'table-row-recommended' : ''} border-b border-slate-100 last:border-0">
                    <td class="px-6 py-4 font-semibold text-slate-900 flex items-center">
                        ${c.rec ? '<i data-lucide="check-circle-2" class="text-blue-600 mr-2 w-4 h-4"></i>' : ''}
                        ${c.name}
                    </td>
                    <td class="px-6 py-4"><span class="badge ${getStyleClass(c.impact)}">${c.impact}</span></td>
                    <td class="px-6 py-4"><span class="badge ${getStyleClass(c.viability)}">${c.viability}</span></td>
                    <td class="px-6 py-4"><span class="badge ${getStyleClass(c.data)}">${c.data}</span></td>
                    <td class="px-6 py-4"><span class="badge ${getStyleClass(c.effort)}">${c.effort}</span></td>
                    <td class="px-6 py-4"><span class="badge ${getStyleClass(c.speed)}">${c.speed}</span></td>
                </tr>
            `).join('');

