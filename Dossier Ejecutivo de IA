        /* Smooth transitions */
        .fade-in {
            animation: fadeIn 0.4s ease-in-out;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Sidebar item hover effects */
        .sidebar-item {
            transition: all 0.2s ease;
        }
        .sidebar-item.active {
            background-color: #2563eb; /* blue-600 */
            color: white;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }
        .sidebar-item:not(.active):hover {
            background-color: #1e293b; /* slate-800 */
            color: #e2e8f0; /* slate-200 */
        }

        /* Badge Styles */
        .badge {
            display: inline-block;
            padding: 0.25rem 0.6rem;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 600;
            border-width: 1px;
        }
        .badge-danger { background-color: #fee2e2; color: #991b1b; border-color: #fecaca; }
        .badge-warning { background-color: #fef3c7; color: #92400e; border-color: #fde68a; }
        .badge-success { background-color: #d1fae5; color: #065f46; border-color: #a7f3d0; }
        .badge-info { background-color: #dbeafe; color: #1e40af; border-color: #bfdbfe; }
        .badge-purple { background-color: #f3e8ff; color: #6b21a8; border-color: #e9d5ff; }
        .badge-neutral { background-color: #f1f5f9; color: #1e293b; border-color: #e2e8f0; }

        /* Table styles */
        .table-row-hover:hover { background-color: #f8fafc; }
        .table-row-recommended { background-color: #eff6ff; } /* blue-50 */
